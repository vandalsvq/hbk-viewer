////////////////////////////////////////////////////////////////////////////////
// Самопроверка формы. Подставляется в модуль общей формы тестовой конфигурации,
// во внешнюю обработку не входит: её собирает build_check.py, а гоняет check_app.bsl.
////////////////////////////////////////////////////////////////////////////////

Функция ПакетЗагружен() Экспорт

	Возврат Пакет <> Неопределено;

КонецФункции

// Что форма показывает пользователю в строке состояния - чтобы драйвер видел причину,
// если пакет так и не загрузился.
Функция СостояниеФормы() Экспорт

	Возврат "путь """ + ПутьПакета + """, состояние """ + Состояние + """";

КонецФункции

// Где читались файлы. Прогон в строгом режиме должен уходить на сервер, обычный -
// работать сам; обе ветки надо видеть в отчёте, а не угадывать.
Функция ГдеЧитаемФайлы() Экспорт

	Возврат ?(РаботаНаСервере, "сервер", "клиент");

КонецФункции

Функция Самопроверка() Экспорт

	Отчёт = Новый Массив;
	Отчёт.Добавить("состояние формы: " + Состояние);
	Отчёт.Добавить("файлы читает: " + ГдеЧитаемФайлы());

	Если Пакет = Неопределено Тогда
		Отчёт.Добавить("ОШИБКА 0. пакет не загружен, дальше проверять нечего");
		Возврат СтрСоединить(Отчёт, Символы.ПС);
	КонецЕсли;

	ПроверитьРазметку(Отчёт);
	ПроверитьДерево(Отчёт);
	ПроверитьРазворачивание(Отчёт);
	ПроверитьПоиск(Отчёт);
	ПроверитьСтатьюИИсторию(Отчёт);
	ПроверитьСсылки(Отчёт);
	ПроверитьНавигациюПоСодержанию(Отчёт);
	ПроверитьИконки(Отчёт);

	Отчёт.Добавить("ГОТОВО");

	Возврат СтрСоединить(Отчёт, Символы.ПС);

КонецФункции

// Разметку headless-прогон глазами не увидит, поэтому сверяем её с ожидаемой:
// платформа молча выбрасывает элементы, которые не поняла при загрузке XML,
// и форма открывается без половины интерфейса.
Процедура ПроверитьРазметку(знач Отчёт)

	Ожидаемые = "Панели,СтраницаСодержание,СтраницаИндекс,Дерево,ДеревоКартинка,ДеревоПредставление,"
		+ "Поиск,Совпадения,СовпаденияКартинка,СовпаденияПредставление,"
		+ "ПолеСтатьи,ПолеСостояния,ОткрытьФайлСправки,Назад,Вперёд,"
		+ "Вышестоящий,Нижестоящий,НайтиВДереве";

	Пропавшие = "";
	Для Каждого Имя Из СтрРазделить(Ожидаемые, ",", Ложь) Цикл
		Если Элементы.Найти(Имя) = Неопределено Тогда
			Пропавшие = Пропавшие + ?(ПустаяСтрока(Пропавшие), "", ", ") + Имя;
		КонецЕсли;
	КонецЦикла;
	Отчёт.Добавить(Итог("0a. все элементы формы на месте", ПустаяСтрока(Пропавшие),
		?(ПустаяСтрока(Пропавшие), "проверено " + СтрЧислоСтрок(СтрЗаменить(Ожидаемые, ",", Символы.ПС)),
			"нет: " + Пропавшие)));

	// Колонки могут лежать в группе ячейки, поэтому считаем не прямых подчинённых,
	// а вложенность: иначе проверка ломается от любой перекомпоновки колонок.
	Отчёт.Добавить(Итог("0b. колонки дерева на месте",
		ВнутриЭлемента(Элементы.ДеревоКартинка, Элементы.Дерево)
		И ВнутриЭлемента(Элементы.ДеревоПредставление, Элементы.Дерево)
		И Элементы.ДеревоКартинка.Вид = ВидПоляФормы.ПолеКартинки,
		"картинка как " + Элементы.ДеревоКартинка.Вид
		+ ", прямых подчинённых " + Элементы.Дерево.ПодчиненныеЭлементы.Количество()));

	Отчёт.Добавить(Итог("0c. виды прочих полей",
		Элементы.ПолеСостояния.Вид = ВидПоляФормы.ПолеНадписи
		И Элементы.ПолеСтатьи.Вид = ВидПоляФормы.ПолеHTMLДокумента
		И Элементы.СовпаденияКартинка.Вид = ВидПоляФормы.ПолеКартинки,
		"состояние " + Элементы.ПолеСостояния.Вид + ", статья " + Элементы.ПолеСтатьи.Вид));

	Отчёт.Добавить(Итог("0d. открыта страница содержания",
		Элементы.Панели.ТекущаяСтраница = Элементы.СтраницаСодержание,
		"страница " + Элементы.Панели.ТекущаяСтраница.Имя + ", дерево видимо: "
		+ Элементы.Дерево.Видимость));

КонецПроцедуры

Процедура ПроверитьДерево(знач Отчёт)

	Корни = Дерево.ПолучитьЭлементы();
	Отчёт.Добавить(Итог("1. верхний уровень дерева", Корни.Количество() > 0,
		"строк " + Корни.Количество()));

	Если Корни.Количество() = 0 Тогда
		Возврат;
	КонецЕсли;

	Первый = Корни[0];
	Отчёт.Добавить(Итог("2. представление строки", Не ПустаяСтрока(Первый.Представление),
		"" + Первый.Представление));
	Отчёт.Добавить(Итог("3. картинка строки", ТипЗнч(Первый.Картинка) = Тип("Картинка"),
		"тип " + ТипЗнч(Первый.Картинка)));

	СЗаглушкой = 0;
	Для Каждого Строка Из Корни Цикл
		Вложенные = Строка.ПолучитьЭлементы();
		Если Вложенные.Количество() = 1 И Вложенные[0].Заглушка Тогда
			СЗаглушкой = СЗаглушкой + 1;
		КонецЕсли;
	КонецЦикла;
	Отчёт.Добавить(Итог("4. заглушки под узлами с детьми", СЗаглушкой > 0,
		"узлов с заглушкой " + СЗаглушкой + " из " + Корни.Количество()));

КонецПроцедуры

// Активизацию строки проверяем отдельно: событие ПриАктивизацииСтроки платформа
// обрабатывает не в момент присваивания, а на следующем шаге цикла событий.
// Драйвер вызывает начало, выжидает такт и передаёт ожидаемый путь обратно.
Функция НачатьПроверкуАктивизации() Экспорт

	// Переходить нужно на строку, которая ещё не текущая: без смены строки
	// платформе нечего обрабатывать и событие не возникнет.
	Для Каждого Строка Из Дерево.ПолучитьЭлементы() Цикл
		Идентификатор = Строка.ПолучитьИдентификатор();
		Если Не ПустаяСтрока(Строка.Путь) И Идентификатор <> Элементы.Дерево.ТекущаяСтрока Тогда
			Статья = "";
			ТекущийПуть = "";
			Элементы.Дерево.ТекущаяСтрока = Идентификатор;
			Возврат Строка.Путь;
		КонецЕсли;
	КонецЦикла;

	Возврат "";

КонецФункции

Функция ПроверитьАктивизацию(знач ОжидаемыйПуть) Экспорт

	Если ПустаяСтрока(ОжидаемыйПуть) Тогда
		Возврат "32. среди корней нет статьи - активизацию проверить не на чем";
	КонецЕсли;

	ТекущиеДанные = Элементы.Дерево.ТекущиеДанные;
	Строки = Новый Массив;
	Строки.Добавить(Итог("32. текущая строка дерева", ТекущиеДанные <> Неопределено,
		?(ТекущиеДанные = Неопределено, "ТекущиеДанные пустые", "" + ТекущиеДанные.Представление)));
	Строки.Добавить(Итог("33. событие активизации показало статью",
		ТекущийПуть = ОжидаемыйПуть И СтрДлина(Статья) > 0,
		"путь " + ТекущийПуть + ", символов " + СтрДлина(Статья)));

	Возврат СтрСоединить(Строки, Символы.ПС);

КонецФункции

Процедура ПроверитьРазворачивание(знач Отчёт)

	СтрокаСДетьми = Неопределено;
	Для Каждого Строка Из Дерево.ПолучитьЭлементы() Цикл
		Вложенные = Строка.ПолучитьЭлементы();
		Если Вложенные.Количество() = 1 И Вложенные[0].Заглушка Тогда
			СтрокаСДетьми = Строка;
			Прервать;
		КонецЕсли;
	КонецЦикла;

	Если СтрокаСДетьми = Неопределено Тогда
		Отчёт.Добавить("ОШИБКА 6. не нашлось ни одной строки с заглушкой");
		Возврат;
	КонецЕсли;

	Ожидаемо = Пакет.Дети.Получить(СтрокаСДетьми.Идентификатор);
	Ожидаемо = ?(Ожидаемо = Неопределено, 0, Ожидаемо.Количество());

	// Разворачиваем по-настоящему, а не вызовом обработчика: событие приносит
	// идентификатор строки, и подменять его готовой строкой - значит не проверить ничего.
	Часы = ТекущаяУниверсальнаяДатаВМиллисекундах();
	Элементы.Дерево.Развернуть(СтрокаСДетьми.ПолучитьИдентификатор());
	Прошло = ТекущаяУниверсальнаяДатаВМиллисекундах() - Часы;

	Получилось = СтрокаСДетьми.ПолучитьЭлементы().Количество();
	Отчёт.Добавить(Итог("6. ленивое разворачивание """ + СтрокаСДетьми.Представление + """",
		Получилось = Ожидаемо И Получилось > 0,
		"детей " + Получилось + ", ожидалось " + Ожидаемо + ", за " + Прошло + " мс"));

	Элементы.Дерево.Развернуть(СтрокаСДетьми.ПолучитьИдентификатор());
	Отчёт.Добавить(Итог("7. повторное разворачивание не дублирует",
		СтрокаСДетьми.ПолучитьЭлементы().Количество() = Получилось,
		"детей " + СтрокаСДетьми.ПолучитьЭлементы().Количество()));

	Глубже = Неопределено;
	Для Каждого Строка Из СтрокаСДетьми.ПолучитьЭлементы() Цикл
		Вложенные = Строка.ПолучитьЭлементы();
		Если Вложенные.Количество() = 1 И Вложенные[0].Заглушка Тогда
			Глубже = Строка;
			Прервать;
		КонецЕсли;
	КонецЦикла;

	Если Глубже = Неопределено Тогда
		Отчёт.Добавить("8. на втором уровне узлов с детьми нет - проверить нечего");
	Иначе
		Элементы.Дерево.Развернуть(Глубже.ПолучитьИдентификатор());
		Отчёт.Добавить(Итог("8. разворачивание второго уровня """ + Глубже.Представление + """",
			Глубже.ПолучитьЭлементы().Количество() > 0,
			"детей " + Глубже.ПолучитьЭлементы().Количество()));
	КонецЕсли;

КонецПроцедуры

Процедура ПроверитьПоиск(знач Отчёт)

	Поиск = "ТаблицаЗначений";
	Часы = ТекущаяУниверсальнаяДатаВМиллисекундах();
	ЗаполнитьСовпадения();
	Прошло = ТекущаяУниверсальнаяДатаВМиллисекундах() - Часы;

	Отчёт.Добавить(Итог("9. поиск по русскому имени", Совпадения.Количество() > 0,
		"совпадений " + Совпадения.Количество() + " за " + Прошло + " мс"));

	Если Совпадения.Количество() > 0 Тогда
		Первое = Совпадения[0];
		Отчёт.Добавить(Итог("10. строка совпадения",
			Не ПустаяСтрока(Первое.Представление) И Не ПустаяСтрока(Первое.Путь)
				И ТипЗнч(Первое.Картинка) = Тип("Картинка"),
			Первое.Представление + " -> " + Первое.Путь));
	КонецЕсли;

	Поиск = "ValueTable";
	ЗаполнитьСовпадения();
	Отчёт.Добавить(Итог("11. поиск по английскому имени", Совпадения.Количество() > 0,
		"совпадений " + Совпадения.Количество()));

	Поиск = "";
	ЗаполнитьСовпадения();
	Отчёт.Добавить(Итог("12. пустой запрос очищает список", Совпадения.Количество() = 0,
		"совпадений " + Совпадения.Количество()));

	// Два удачных запроса были выше, пустой в историю попасть не должен.
	Список = Элементы.Поиск.СписокВыбора;
	Отчёт.Добавить(Итог("12a. запросы попали в список выбора", Список.Количество() = 2
		И Список[0].Значение = "ValueTable",
		"запомнено " + Список.Количество() + ", первый """
		+ ?(Список.Количество() = 0, "", Список[0].Значение) + """"));

КонецПроцедуры

Процедура ПроверитьСтатьюИИсторию(знач Отчёт)

	Узлы = НайтиПоПрефиксу(Пакет, "Таблица", 2);
	Если Узлы.Количество() < 2 Тогда
		Отчёт.Добавить("ОШИБКА 13. в оглавлении не нашлось двух статей для проверки истории");
		Возврат;
	КонецЕсли;

	ПоказатьСтатью(Узлы[0].Путь, Истина);
	Первая = Статья;
	Отчёт.Добавить(Итог("13. статья показана", СтрДлина(Первая) > 0 И СтрНайти(Первая, "<") > 0,
		"символов " + СтрДлина(Первая) + ", путь " + ТекущийПуть));

	ПоказатьСтатью(Узлы[1].Путь, Истина);
	Отчёт.Добавить(Итог("14. переход к следующей статье", Статья <> Первая И СтрДлина(Статья) > 0,
		"символов " + СтрДлина(Статья) + ", путь " + ТекущийПуть));
	Отчёт.Добавить(Итог("15. кнопка Назад включилась", Элементы.Назад.Доступность,
		"позиция " + ПозицияИстории + " из " + История.Количество()));

	Назад(Неопределено);
	Отчёт.Добавить(Итог("16. возврат по истории", ТекущийПуть = Узлы[0].Путь И Статья = Первая,
		"путь " + ТекущийПуть));
	Отчёт.Добавить(Итог("17. кнопка Вперёд включилась", Элементы.Вперёд.Доступность,
		"позиция " + ПозицияИстории + " из " + История.Количество()));

	Вперёд(Неопределено);
	Отчёт.Добавить(Итог("18. переход вперёд по истории", ТекущийПуть = Узлы[1].Путь,
		"путь " + ТекущийПуть));

	Часы = ТекущаяУниверсальнаяДатаВМиллисекундах();
	ПоказатьСтатью(Узлы[0].Путь, Ложь);
	Отчёт.Добавить(Итог("19. повторный показ из кеша",
		ТекущаяУниверсальнаяДатаВМиллисекундах() - Часы < 50,
		"за " + (ТекущаяУниверсальнаяДатаВМиллисекундах() - Часы) + " мс"));

КонецПроцедуры

Процедура ПроверитьСсылки(знач Отчёт)

	Откуда = "/objects/catalog234/catalog236/ValueTable.html";

	Относительная = ПутьПоСсылке("ValueTable/methods/Add110.html", Откуда);
	Отчёт.Добавить(Итог("20. относительная ссылка",
		Относительная = "/objects/catalog234/catalog236/ValueTable/methods/Add110.html",
		Относительная));

	Абсолютная = ПутьПоСсылке("v8help://SyntaxHelperContext/objects/catalog234/ValueTableRow.html", Откуда);
	Отчёт.Добавить(Итог("21. ссылка v8help", Абсолютная = "/objects/catalog234/ValueTableRow.html", Абсолютная));

	СТочками = ПутьПоСсылке("../../Array.html#top", Откуда);
	Отчёт.Добавить(Итог("22. ссылка с ../ и якорем", СТочками = "/objects/Array.html", СТочками));

	Внешняя = ПутьПоСсылке("https://its.1c.ru/db/v8std", Откуда);
	Отчёт.Добавить(Итог("23. внешняя ссылка остаётся браузеру", Внешняя = "", """" + Внешняя + """"));

	Живая = ПутьПоСсылке("ValueTable/methods/Add110.html", Откуда);
	Отчёт.Добавить(Итог("24. статья по вычисленной ссылке существует",
		СтрДлина(СтатьяПоПути(Живая)) > 0,
		"символов " + СтрДлина(СтатьяПоПути(Живая))));

КонецПроцедуры

Процедура ПроверитьНавигациюПоСодержанию(знач Отчёт)

	// Берём статью поглубже: у верхних уровней вышестоящего может не быть.
	Узлы = НайтиПоПрефиксу(Пакет, "ТаблицаЗначений", 1);
	Если Узлы.Количество() = 0 Тогда
		Отчёт.Добавить("ОШИБКА 26. не нашлось статьи для проверки навигации");
		Возврат;
	КонецЕсли;

	ПоказатьСтатью(Узлы[0].Путь, Истина);
	Отправная = ТекущийПуть;

	Часы = ТекущаяУниверсальнаяДатаВМиллисекундах();
	Узел = УзелПоПути(Пакет, Отправная);
	Отчёт.Добавить(Итог("26. статья находится в оглавлении по пути", Узел <> Неопределено,
		?(Узел = Неопределено, Отправная, Узел.ИмяРу) + ", за "
		+ (ТекущаяУниверсальнаяДатаВМиллисекундах() - Часы) + " мс"));

	Если Узел = Неопределено Тогда
		Возврат;
	КонецЕсли;

	Цепочка = ЦепочкаДоУзла(Пакет, Узел);
	Отчёт.Добавить(Итог("27. цепочка от корня до статьи",
		Цепочка.Количество() > 1 И Цепочка[Цепочка.Количество() - 1] = Узел,
		"звеньев " + Цепочка.Количество()));

	СтрокаДерева = РаскрытьДоУзла(Узел);
	Отчёт.Добавить(Итог("28. содержание раскрылось до статьи", СтрокаДерева <> Неопределено,
		?(СтрокаДерева = Неопределено, "строка не найдена", "" + СтрокаДерева.Представление)));

	Нижестоящий(Неопределено);
	Отчёт.Добавить(Итог("29. переход к нижестоящей статье", ТекущийПуть <> Отправная
		И Не ПустаяСтрока(ТекущийПуть), "путь " + ТекущийПуть));

	Вышестоящий(Неопределено);
	Отчёт.Добавить(Итог("30. переход к вышестоящей статье", ТекущийПуть = Отправная,
		"путь " + ТекущийПуть));

КонецПроцедуры

Процедура ПроверитьИконки(знач Отчёт)

	Пропущенные = "";
	Для Каждого Вид Из СтрРазделить("Раздел,Объект,Метод,Свойство,Событие,Статья", ",", Ложь) Цикл
		Если ТипЗнч(Иконки.Получить(Вид)) <> Тип("Картинка") Тогда
			Пропущенные = Пропущенные + ?(ПустаяСтрока(Пропущенные), "", ", ") + Вид;
		КонецЕсли;
	КонецЦикла;

	Отчёт.Добавить(Итог("31. иконки всех видов узлов", ПустаяСтрока(Пропущенные),
		?(ПустаяСтрока(Пропущенные), "видов " + Иконки.Количество(), "нет: " + Пропущенные)));

КонецПроцедуры

// Истина, если элемент лежит внутри владельца на любой глубине вложенности.
Функция ВнутриЭлемента(знач Элемент, знач Владелец)

	Текущий = Элемент;

	Пока Текущий <> Неопределено Цикл
		Если Текущий = Владелец Тогда
			Возврат Истина;
		КонецЕсли;
		Текущий = Текущий.Родитель;
	КонецЦикла;

	Возврат Ложь;

КонецФункции

Функция Итог(знач Имя, знач Успех, знач Подробности = "")

	Возврат ?(Успех, "ОК   ", "ОШИБКА ") + Имя + ?(ПустаяСтрока(Подробности), "", ": " + Подробности);

КонецФункции
