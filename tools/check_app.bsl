// Драйвер headless-проверки формы: подставляется в модуль управляемого приложения
// тестовой конфигурации, открывает общую форму, дожидается загрузки пакета,
// вызывает её самопроверку и завершает работу.
//
// Файлов не касается: модуль клиентский, а в строгом режиме файловые методы на
// клиенте запрещены. Отчёт и трассу пишет общий модуль Стенд.

Перем ФормаПроверки;

Перем ОсталосьОпросов;

Перем НакопленныйОтчёт;

Перем ОжидаемыйПуть;

Процедура ПриНачалеРаботыСистемы()

	Стенд.ОчиститьОтчёты();
	Стенд.ДописатьТрассу("старт");

	Попытка
		ФормаПроверки = ОткрытьФорму("ОбщаяФорма.ПроверкаФормы");
	Исключение
		Завершить("ОШИБКА открытия формы: " + ПодробноеПредставлениеОшибки(ИнформацияОбОшибке()));
		Возврат;
	КонецПопытки;

	Стенд.ДописатьТрассу("форма открыта");

	// Пакет готовится в обработчике ожидания формы, поэтому ждём его появления.
	// Интервал меньше секунды платформа принимает только у однократных обработчиков.
	ОсталосьОпросов = 20;
	ПодключитьОбработчикОжидания("ОпроситьФорму", 1);

КонецПроцедуры

Процедура ОпроситьФорму() Экспорт

	ОсталосьОпросов = ОсталосьОпросов - 1;

	Попытка
		Готово = ФормаПроверки.ПакетЗагружен();
	Исключение
		ОтключитьОбработчикОжидания("ОпроситьФорму");
		Завершить("ОШИБКА опроса формы: " + ПодробноеПредставлениеОшибки(ИнформацияОбОшибке()));
		Возврат;
	КонецПопытки;

	Если Не Готово И ОсталосьОпросов > 0 Тогда
		Стенд.ДописатьТрассу("жду пакет (" + ОсталосьОпросов + "): " + ФормаПроверки.СостояниеФормы());
		Возврат;
	КонецЕсли;

	ОтключитьОбработчикОжидания("ОпроситьФорму");
	Стенд.ДописатьТрассу(?(Готово, "пакет готов, запускаю самопроверку",
		"пакет так и не загрузился: " + ФормаПроверки.СостояниеФормы()));

	Попытка
		НакопленныйОтчёт = ФормаПроверки.Самопроверка();
		ОжидаемыйПуть = ФормаПроверки.НачатьПроверкуАктивизации();
	Исключение
		Завершить("ИСКЛЮЧЕНИЕ в самопроверке: " + ПодробноеПредставлениеОшибки(ИнформацияОбОшибке()));
		Возврат;
	КонецПопытки;

	// Событию активизации строки нужен такт цикла событий - дочитываем результат следом.
	ПодключитьОбработчикОжидания("ДопроверитьФорму", 1, Истина);

КонецПроцедуры

Процедура ДопроверитьФорму() Экспорт

	Попытка
		Хвост = ФормаПроверки.ПроверитьАктивизацию(ОжидаемыйПуть);
	Исключение
		Хвост = "ИСКЛЮЧЕНИЕ в проверке активизации: " + ПодробноеПредставлениеОшибки(ИнформацияОбОшибке());
	КонецПопытки;

	Завершить(НакопленныйОтчёт + Символы.ПС + Хвост + Символы.ПС + "ГОТОВО");

КонецПроцедуры

Процедура Завершить(знач Отчёт)

	Стенд.ДописатьТрассу("завершение");
	Стенд.ЗаписатьОтчёт(Отчёт);

	Если Стенд.ОставитьОкно() Тогда
		Стенд.ДописатьТрассу("окно оставлено открытым по флагу");
		Возврат;
	КонецЕсли;

	// Единственный параметр - не спрашивать о несохранённом. Второй параметр метода
	// означает перезапуск сеанса, а не принудительность: с ним прогон зацикливается.
	ЗавершитьРаботуСистемы(Ложь);

КонецПроцедуры
