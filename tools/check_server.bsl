////////////////////////////////////////////////////////////////////////////////
// Серверная часть стенда: пишет отчёт и трассу прогона.
//
// Живёт в общем модуле тестовой конфигурации, потому что модуль управляемого
// приложения клиентский, а файловые методы на клиенте в строгом режиме запрещены.
////////////////////////////////////////////////////////////////////////////////

Процедура ОчиститьОтчёты() Экспорт

	Для Каждого Путь Из ФайлыОтчёта() Цикл
		Файл = Новый Файл(Путь);
		Если Файл.Существует() Тогда
			УдалитьФайлы(Путь);
		КонецЕсли;
	КонецЦикла;

КонецПроцедуры

Процедура ЗаписатьОтчёт(знач Текст) Экспорт

	Док = Новый ТекстовыйДокумент;
	Для Каждого Строка Из СтрРазделить(Текст, Символы.ПС, Истина) Цикл
		Док.ДобавитьСтроку(Строка);
	КонецЦикла;
	Док.Записать(ФайлОтчёта(), КодировкаТекста.UTF8);

КонецПроцедуры

Процедура ДописатьТрассу(знач Текст) Экспорт

	Запись = Новый ЗаписьТекста(ФайлТрассы(), КодировкаТекста.UTF8, Символы.ПС, Истина);
	Запись.ЗаписатьСтроку(Формат(ТекущаяДатаСеанса(), "ДФ=HH:mm:ss") + " " + Текст);
	Запись.Закрыть();

КонецПроцедуры

// Флаг ставит build_check.py ключом --окно: отчёт уже записан, а форму оставляем
// на экране, чтобы посмотреть на неё глазами.
Функция ОставитьОкно() Экспорт

	Флаг = Новый Файл(КаталогВременныхФайлов() + "hbk_check_keep.flag");

	Возврат Флаг.Существует();

КонецФункции

Функция ФайлыОтчёта()

	Результат = Новый Массив;
	Результат.Добавить(ФайлОтчёта());
	Результат.Добавить(ФайлТрассы());

	Возврат Результат;

КонецФункции

Функция ФайлОтчёта()

	Возврат КаталогВременныхФайлов() + "hbk_check.log";

КонецФункции

Функция ФайлТрассы()

	Возврат КаталогВременныхФайлов() + "hbk_check_trace.log";

КонецФункции
