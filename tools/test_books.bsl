// Стенд: что лежит в других пакетах справки платформы и сколько стоит их прочитать.
//
// Ответ на вопрос владельца - какие пакеты имеет смысл показывать рядом с синтакс-
// помощником (язык запросов, СКД) и во что это обойдётся по времени загрузки.

Перем Отчёт;

Процедура ПередНачаломРаботыСистемы(Отказ)

	Отчёт = Новый Массив;

	Попытка
		ПрогнатьПроверки();
	Исключение
		Отчёт.Добавить("ИСКЛЮЧЕНИЕ: " + ПодробноеПредставлениеОшибки(ИнформацияОбОшибке()));
	КонецПопытки;

	Док = Новый ТекстовыйДокумент;
	Для Каждого Строка Из Отчёт Цикл
		Док.ДобавитьСтроку(Строка);
	КонецЦикла;
	Док.Записать(КаталогВременныхФайлов() + "spike.log", КодировкаТекста.UTF8);

	Отказ = Истина;

КонецПроцедуры

Процедура ПрогнатьПроверки()

	Каталог = Новый Файл(НайтиФайлСправки());
	Отчёт.Добавить("каталог пакетов: " + Каталог.Путь);
	Отчёт.Добавить("");

	Кандидаты = "shcntx,shlang,shclang,shquery,dcsui,ecsui,moxelui,schemui";

	Для Каждого Префикс Из СтрРазделить(Кандидаты, ",", Ложь) Цикл
		ПроверитьПакет(Префикс);
	КонецЦикла;

КонецПроцедуры

Процедура ПроверитьПакет(знач Префикс)

	Путь = НайтиФайлСправки(Префикс);
	Если ПустаяСтрока(Путь) Тогда
		Отчёт.Добавить(Префикс + ": пакет не найден");
		Возврат;
	КонецЕсли;

	Файл = Новый Файл(Путь);
	Часы = ТекущаяУниверсальнаяДатаВМиллисекундах();

	Попытка
		Пакет = СобратьПакет(ПодготовитьПакет(Путь));
	Исключение
		Отчёт.Добавить(Префикс + ": НЕ ПРОЧИТАЛСЯ - "
			+ КраткоеПредставлениеОшибки(ИнформацияОбОшибке()));
		Возврат;
	КонецПопытки;

	Прошло = ТекущаяУниверсальнаяДатаВМиллисекундах() - Часы;

	Отчёт.Добавить(СтрШаблон("%1 (%2, %3 КБ): узлов %4, статей %5, загрузка %6 мс",
		Префикс, Файл.Имя, Формат(Файл.Размер() / 1024, "ЧЦ=9; ЧДЦ=0"),
		Пакет.Узлы.Количество(), Пакет.Индекс.Количество(), Прошло));

	Корни = ДетиУзла(Пакет);
	Для Каждого Узел Из Корни Цикл
		Отчёт.Добавить("    " + Узел.ИмяРу + ?(ПустаяСтрока(Узел.ИмяEn), "", " (" + Узел.ИмяEn + ")")
			+ " - детей " + Узел.ЧислоДетей);
	КонецЦикла;

	Отчёт.Добавить("");

КонецПроцедуры
