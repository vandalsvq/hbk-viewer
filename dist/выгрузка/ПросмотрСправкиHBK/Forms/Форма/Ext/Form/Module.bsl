////////////////////////////////////////////////////////////////////////////////
// Форма просмотрщика справки 1С. Интерфейс штатный: дерево, таблица, поля формы.
// HTML живёт только внутри поля статьи.
//
// Параметров у формы нет: путь к пакету подбирается сам, сменить его можно кнопкой
// "Открыть". Модуль собирается из .bsl-файлов сборщиком formsrc.py - править его
// в конфигураторе бесполезно, правки затрёт следующая сборка.
////////////////////////////////////////////////////////////////////////////////

#Область ОписаниеПеременных

&НаКлиенте
Перем Пакет; // Структура - прочитанный пакет: оглавление, индексы, кеш статей.

&НаКлиенте
Перем Иконки; // Соответствие - картинка узла по его виду.

&НаКлиенте
Перем История; // Массив из Строка - пути просмотренных статей в порядке перехода.

&НаКлиенте
Перем ПозицияИстории; // Число - место в истории, считая с единицы.

&НаКлиенте
Перем ТекущийПуть; // Строка - путь показанной статьи.

&НаКлиенте
Перем РаботаНаСервере; // Булево - Ложь: файлы читает сам клиент, Истина: ходим на сервер.

#КонецОбласти

#Область ОбработчикиСобытийФормы

&НаКлиенте
Процедура ПриОткрытии(Отказ)

	Иконки = ИконкиУзлов();
	История = Новый Массив;
	ПозицияИстории = 0;
	ТекущийПуть = "";
	РаботаНаСервере = Ложь;
	Состояние = НСтр("ru = 'Готовлю справку...'");
	Элементы.Панели.ТекущаяСтраница = Элементы.СтраницаСодержание;

	// Пакет готовится после отрисовки формы, иначе окно висит пустым около секунды.
	ПодключитьОбработчикОжидания("ОткрытьПакетОтложенно", 0.2, Истина);

КонецПроцедуры

#КонецОбласти

#Область ОбработчикиСобытийЭлементовШапкиФормы

&НаКлиенте
Процедура ПоискПриИзменении(Элемент)

	ЗаполнитьСовпадения();

КонецПроцедуры

// Ссылки внутри статьи ведут в саму справку, поэтому браузеру их не отдаём:
// вычисляем путь в оглавлении и показываем статью в том же поле.
&НаКлиенте
Процедура ПолеСтатьиПриНажатии(Элемент, ДанныеСобытия, СтандартнаяОбработка)

	Ссылка = СсылкаНажатия(ДанныеСобытия);
	Если ПустаяСтрока(Ссылка) Тогда
		Возврат;
	КонецЕсли;

	СтандартнаяОбработка = Ложь;

	Путь = ПутьПоСсылке(Ссылка, ТекущийПуть);
	Если ПустаяСтрока(Путь) Тогда
		Возврат;
	КонецЕсли;

	ПоказатьСтатью(Путь, Истина);

КонецПроцедуры

#КонецОбласти

#Область ОбработчикиСобытийЭлементовТаблицыФормыДерево

&НаКлиенте
Процедура ДеревоПередРазворачиванием(Элемент, Строка, Отказ)

	// Событие приносит идентификатор строки: превращаем его в строку дерева здесь,
	// чтобы дальше по коду тип был один.
	СтрокаДерева = Дерево.НайтиПоИдентификатору(Строка);
	Если СтрокаДерева = Неопределено Тогда
		Возврат;
	КонецЕсли;

	ЗаполнитьДетей(СтрокаДерева);

КонецПроцедуры

&НаКлиенте
Процедура ДеревоПриАктивизацииСтроки(Элемент)

	ТекущиеДанные = Элементы.Дерево.ТекущиеДанные;
	Если ТекущиеДанные = Неопределено Или ПустаяСтрока(ТекущиеДанные.Путь) Тогда
		Возврат;
	КонецЕсли;

	ПоказатьСтатью(ТекущиеДанные.Путь, Истина);

КонецПроцедуры

#КонецОбласти

#Область ОбработчикиСобытийЭлементовТаблицыФормыСовпадения

&НаКлиенте
Процедура СовпаденияПриАктивизацииСтроки(Элемент)

	ТекущиеДанные = Элементы.Совпадения.ТекущиеДанные;
	Если ТекущиеДанные = Неопределено Тогда
		Возврат;
	КонецЕсли;

	ПоказатьСтатью(ТекущиеДанные.Путь, Истина);

КонецПроцедуры

#КонецОбласти

#Область ОбработчикиКомандФормы

&НаКлиенте
Процедура ОткрытьФайлСправки(Команда)

	Диалог = Новый ДиалогВыбораФайла(РежимДиалогаВыбораФайла.Открытие);
	Диалог.Заголовок = НСтр("ru = 'Выберите пакет справки 1С'");
	Диалог.Фильтр = НСтр("ru = 'Пакет справки (*.hbk)|*.hbk'");
	Диалог.ПолноеИмяФайла = ПутьПакета;

	Диалог.Показать(Новый ОписаниеОповещения("ОткрытьФайлСправкиЗавершение", ЭтотОбъект));

КонецПроцедуры

&НаКлиенте
Процедура Назад(Команда)

	Если ПозицияИстории > 1 Тогда
		ПозицияИстории = ПозицияИстории - 1;
		ПоказатьСтатью(История[ПозицияИстории - 1], Ложь);
	КонецЕсли;

КонецПроцедуры

&НаКлиенте
Процедура Вперёд(Команда)

	Если ПозицияИстории < История.Количество() Тогда
		ПозицияИстории = ПозицияИстории + 1;
		ПоказатьСтатью(История[ПозицияИстории - 1], Ложь);
	КонецЕсли;

КонецПроцедуры

&НаКлиенте
Процедура Вышестоящий(Команда)

	ПерейтиКСоседу(Истина);

КонецПроцедуры

&НаКлиенте
Процедура Нижестоящий(Команда)

	ПерейтиКСоседу(Ложь);

КонецПроцедуры

// Показывает в дереве статью, открытую в поле: по ссылкам легко уйти далеко,
// а понять, где находишься, помогает только содержание.
&НаКлиенте
Процедура НайтиВДереве(Команда)

	Узел = ТекущийУзел();
	Если Узел = Неопределено Тогда
		Состояние = НСтр("ru = 'Этой статьи нет в содержании'");
		Возврат;
	КонецЕсли;

	Элементы.Панели.ТекущаяСтраница = Элементы.СтраницаСодержание;

	СтрокаДерева = РаскрытьДоУзла(Узел);
	Если СтрокаДерева = Неопределено Тогда
		Состояние = НСтр("ru = 'Не удалось раскрыть содержание до этой статьи'");
		Возврат;
	КонецЕсли;

	Элементы.Дерево.ТекущаяСтрока = СтрокаДерева.ПолучитьИдентификатор();
	ТекущийЭлемент = Элементы.Дерево;

КонецПроцедуры

#КонецОбласти

#Область СлужебныеПроцедурыИФункции

#Область ЗагрузкаПакета

&НаКлиенте
Процедура ОткрытьПакетОтложенно()

	Если ПустаяСтрока(ПутьПакета) Тогда
		ПутьПакета = НайтиПакет();
	Иначе
		РаботаНаСервере = Не ДоступенОтсюда(ПутьПакета);
	КонецЕсли;

	Если ПустаяСтрока(ПутьПакета) Тогда
		Состояние = НСтр("ru = 'Пакет справки не найден. Укажите файл shcntx_*.hbk кнопкой ""Открыть""'");
		Возврат;
	КонецЕсли;

	ЗагрузитьПакет();

КонецПроцедуры

&НаКлиенте
Процедура ОткрытьФайлСправкиЗавершение(знач ВыбранныеФайлы, знач ДополнительныеПараметры) Экспорт

	Если ВыбранныеФайлы = Неопределено Или ВыбранныеФайлы.Количество() = 0 Тогда
		Возврат;
	КонецЕсли;

	ПутьПакета = ВыбранныеФайлы[0];
	РаботаНаСервере = Не ДоступенОтсюда(ПутьПакета);
	ЗагрузитьПакет();

КонецПроцедуры

&НаКлиенте
Процедура ЗагрузитьПакет()

	Часы = ТекущаяУниверсальнаяДатаВМиллисекундах();

	Попытка
		Ответ = ПодготовитьПакетГдеПолучится(ПутьПакета);
	Исключение
		Состояние = ПодробноеПредставлениеОшибки(ИнформацияОбОшибке());
		Возврат;
	КонецПопытки;

	Если Ответ = Неопределено Тогда
		Состояние = НСтр("ru = 'Пакет справки не прочитать ни здесь, ни на сервере'");
		Возврат;
	КонецЕсли;

	Пакет = СобратьПакет(Ответ);

	Дерево.ПолучитьЭлементы().Очистить();
	Совпадения.Очистить();
	История.Очистить();
	ПозицияИстории = 0;
	ТекущийПуть = "";
	Статья = "";

	Для Каждого Узел Из ДетиУзла(Пакет) Цикл
		ДобавитьУзел(Дерево.ПолучитьЭлементы(), Узел);
	КонецЦикла;

	Состояние = СтрШаблон(НСтр("ru = 'Справка готова: %1 разделов и статей, загружено за %2 мс (%3)'"),
		Пакет.Узлы.Количество(), ТекущаяУниверсальнаяДатаВМиллисекундах() - Часы,
		?(РаботаНаСервере, НСтр("ru = 'файлы читает сервер'"), НСтр("ru = 'файлы читаем сами'")));

КонецПроцедуры

// Ищет пакет там, где он вероятнее лежит: рядом с клиентом, а если оттуда не видно -
// на сервере. Веб-клиенту первый шаг ничего не даёт, и остаётся сразу второй.
&НаКлиенте
Функция НайтиПакет()

	Путь = "";

	Попытка
		Путь = НайтиФайлСправки();
	Исключение
		// Под отладкой со строгой проверкой клиенту файлы запрещены - это не ошибка,
		// просто работать придётся на сервере.
		Путь = "";
	КонецПопытки;

	Если Не ПустаяСтрока(Путь) Тогда
		РаботаНаСервере = Ложь;
		Возврат Путь;
	КонецЕсли;

	Путь = НайтиПакетНаСервере();
	РаботаНаСервере = Не ПустаяСтрока(Путь);

	Возврат Путь;

КонецФункции

&НаСервереБезКонтекста
Функция НайтиПакетНаСервере()

	Возврат НайтиФайлСправки();

КонецФункции

// Читает пакет оттуда, откуда он виден. Сначала пробуем сами: файл лежит рядом с
// клиентом, а серверу он может быть недоступен - другая машина, другая ОС, сетевой каталог.
&НаКлиенте
Функция ПодготовитьПакетГдеПолучится(знач Путь)

	Если Не РаботаНаСервере Тогда
		Попытка
			Ответ = ПодготовитьПакет(Путь);
		Исключение
			Ответ = Неопределено;
		КонецПопытки;

		Если Ответ <> Неопределено Тогда
			Возврат Ответ;
		КонецЕсли;

		РаботаНаСервере = Истина;
	КонецЕсли;

	Возврат ПодготовитьПакетНаСервере(Путь);

КонецФункции

&НаСервереБезКонтекста
Функция ПодготовитьПакетНаСервере(знач ПутьHBK)

	Возврат ПодготовитьПакет(ПутьHBK);

КонецФункции

// Виден ли файл с клиента. В веб-клиенте всегда Ложь.
&НаКлиенте
Функция ДоступенОтсюда(знач Путь)

	Попытка
		Возврат ФайлДоступен(Путь);
	Исключение
		Возврат Ложь;
	КонецПопытки;

КонецФункции

#КонецОбласти

#Область Содержание

// Добавляет узел оглавления в дерево формы.
//
// Узлам с детьми подкладывается строка-заглушка: без дочерней строки платформа не
// нарисует крестик разворачивания, а число детей оглавление сообщает достоверно.
&НаКлиенте
Процедура ДобавитьУзел(знач Строки, знач Узел)

	Строка = Строки.Добавить();
	Строка.Представление = ПредставлениеУзла(Узел);
	Строка.Идентификатор = Узел.Идентификатор;
	Строка.Путь = Узел.Путь;
	Строка.Картинка = Иконки.Получить(ВидУзла(Пакет, Узел));

	Если Узел.ЧислоДетей > 0 Тогда
		Заглушка = Строка.ПолучитьЭлементы().Добавить();
		Заглушка.Представление = НСтр("ru = '...'");
		Заглушка.Заглушка = Истина;
	КонецЕсли;

КонецПроцедуры

// Заменяет строку-заглушку настоящими детьми узла. Повторный вызов ничего не делает.
//
// Параметры:
//  СтрокаДерева - ДанныеФормыЭлементДерева - разворачиваемая строка.
&НаКлиенте
Процедура ЗаполнитьДетей(знач СтрокаДерева)

	Строки = СтрокаДерева.ПолучитьЭлементы();
	Если Строки.Количество() <> 1 Или Не Строки[0].Заглушка Тогда
		Возврат;
	КонецЕсли;

	Строки.Очистить();
	Для Каждого Узел Из ДетиУзла(Пакет, СтрокаДерева.Идентификатор) Цикл
		ДобавитьУзел(Строки, Узел);
	КонецЦикла;

КонецПроцедуры

&НаКлиенте
Функция ПредставлениеУзла(знач Узел)

	Если Узел.Служебный Или ПустаяСтрока(Узел.ИмяEn) Тогда
		Возврат Узел.ИмяРу;
	КонецЕсли;

	Возврат Узел.ИмяРу + " (" + Узел.ИмяEn + ")";

КонецФункции

// Узел оглавления, соответствующий открытой статье.
&НаКлиенте
Функция ТекущийУзел()

	Если Пакет = Неопределено Тогда
		Возврат Неопределено;
	КонецЕсли;

	Возврат УзелПоПути(Пакет, ТекущийПуть);

КонецФункции

// Переход на уровень выше или ниже по содержанию.
&НаКлиенте
Процедура ПерейтиКСоседу(знач Вверх)

	Узел = ТекущийУзел();
	Если Узел = Неопределено Тогда
		Возврат;
	КонецЕсли;

	Сосед = ?(Вверх, ВышестоящийУзел(Пакет, Узел), НижестоящийУзел(Пакет, Узел));
	Если Сосед = Неопределено Тогда
		Состояние = ?(Вверх, НСтр("ru = 'Выше некуда: это верхний уровень'"),
			НСтр("ru = 'Ниже некуда: у статьи нет вложенных'"));
		Возврат;
	КонецЕсли;

	ПоказатьСтатью(Сосед.Путь, Истина);

КонецПроцедуры

// Раскрывает содержание до узла, подгружая уровни по дороге.
//
// Возвращаемое значение:
//  ДанныеФормыЭлементДерева, Неопределено - строка найденного узла.
&НаКлиенте
Функция РаскрытьДоУзла(знач Узел)

	Строки = Дерево.ПолучитьЭлементы();
	Найденная = Неопределено;

	Для Каждого Звено Из ЦепочкаДоУзла(Пакет, Узел) Цикл

		Найденная = СтрокаУзла(Строки, Звено.Идентификатор);
		Если Найденная = Неопределено Тогда
			Возврат Неопределено;
		КонецЕсли;

		ЗаполнитьДетей(Найденная);
		Элементы.Дерево.Развернуть(Найденная.ПолучитьИдентификатор());
		Строки = Найденная.ПолучитьЭлементы();

	КонецЦикла;

	Возврат Найденная;

КонецФункции

// Строка уровня по идентификатору узла оглавления.
&НаКлиенте
Функция СтрокаУзла(знач Строки, знач Идентификатор)

	Для Каждого Строка Из Строки Цикл
		Если Строка.Идентификатор = Идентификатор Тогда
			Возврат Строка;
		КонецЕсли;
	КонецЦикла;

	Возврат Неопределено;

КонецФункции

#КонецОбласти

#Область Индекс

&НаКлиенте
Процедура ЗаполнитьСовпадения()

	Совпадения.Очистить();
	Если Пакет = Неопределено Или ПустаяСтрока(Поиск) Тогда
		Возврат;
	КонецЕсли;

	Найденные = Новый Массив;
	Для Каждого Узел Из НайтиПоПрефиксу(Пакет, Поиск, 300) Цикл
		Найденные.Добавить(Новый Структура("Узел, Представление",
			Узел, ПолноеИмяУзла(Пакет, Узел)));
	КонецЦикла;

	Для Каждого Совпадение Из ПоАлфавиту(Найденные) Цикл
		Строка = Совпадения.Добавить();
		Строка.Представление = Совпадение.Представление;
		Строка.Путь = Совпадение.Узел.Путь;
		Строка.Картинка = Иконки.Получить(ВидУзла(Пакет, Совпадение.Узел));
	КонецЦикла;

	Состояние = СтрШаблон(НСтр("ru = 'Найдено: %1'"), Совпадения.Количество());

	Если Совпадения.Количество() > 0 Тогда
		ЗапомнитьЗапрос(Поиск);
	КонецЕсли;

КонецПроцедуры

// Удачные запросы копятся в списке выбора поля - повторить поиск проще, чем набрать заново.
&НаКлиенте
Процедура ЗапомнитьЗапрос(знач Запрос)

	Список = Элементы.Поиск.СписокВыбора;

	Прежний = Список.НайтиПоЗначению(Запрос);
	Если Прежний <> Неопределено Тогда
		Список.Удалить(Прежний);
	КонецЕсли;

	Список.Вставить(0, Запрос);

	Пока Список.Количество() > 20 Цикл
		Список.Удалить(Список.Количество() - 1);
	КонецЦикла;

КонецПроцедуры

#КонецОбласти

#Область Статья

&НаКлиенте
Процедура ПоказатьСтатью(знач Путь, знач ЗапомнитьВИстории)

	Если Пакет = Неопределено Или ПустаяСтрока(Путь) Тогда
		Возврат;
	КонецЕсли;

	Статья = СтатьяПоПути(Путь);
	ТекущийПуть = Путь;

	Если ЗапомнитьВИстории Тогда
		Пока История.Количество() > ПозицияИстории Цикл
			История.Удалить(История.Количество() - 1);
		КонецЦикла;
		История.Добавить(Путь);
		ПозицияИстории = История.Количество();
	КонецЕсли;

	Элементы.Назад.Доступность = ПозицияИстории > 1;
	Элементы.Вперёд.Доступность = ПозицияИстории < История.Количество();

КонецПроцедуры

// Отдаёт HTML статьи, ходя на сервер только за незнакомыми путями.
//
// Статьи небольшие (в среднем 2 КБ), а возвраты в справку часты, поэтому
// просмотренное держим в памяти клиента: повторный показ мгновенный и без вызова.
&НаКлиенте
Функция СтатьяПоПути(знач Путь)

	ИзКеша = Пакет.Кеш.Получить(Путь);
	Если ИзКеша <> Неопределено Тогда
		Возврат ИзКеша;
	КонецЕсли;

	Место = МестоСтатьи(Пакет, Путь);
	Если Место = Неопределено Тогда
		Возврат "";
	КонецЕсли;

	Если РаботаНаСервере Тогда
		Текст = ПрочитатьСтатьюНаСервере(Пакет.ПутьХранилища, Место.Смещение, Место.Размер);
	Иначе
		Текст = ПрочитатьСтатью(Пакет.ПутьХранилища, Место.Смещение, Место.Размер);
	КонецЕсли;

	Пакет.Кеш.Вставить(Путь, Текст);

	Возврат Текст;

КонецФункции

&НаСервереБезКонтекста
Функция ПрочитатьСтатьюНаСервере(знач ПутьХранилища, знач Смещение, знач Размер)

	Возврат ПрочитатьСтатью(ПутьХранилища, Смещение, Размер);

КонецФункции

// Достаёт адрес из события поля HTML. Приоритет у исходного атрибута ссылки:
// документ показан из строки, базового адреса у него нет, и браузер дописывает
// относительным ссылкам собственный префикс.
&НаКлиенте
Функция СсылкаНажатия(знач ДанныеСобытия)

	Если ДанныеСобытия = Неопределено Или ДанныеСобытия.Anchor = Неопределено Тогда
		Возврат "";
	КонецЕсли;

	Адрес = "";

	Попытка
		Атрибут = ДанныеСобытия.Anchor.getAttribute("href");
		Если Атрибут <> Неопределено Тогда
			Адрес = Строка(Атрибут);
		КонецЕсли;
	Исключение
		Адрес = "";
	КонецПопытки;

	Если ПустаяСтрока(Адрес) И ДанныеСобытия.Href <> Неопределено Тогда
		Адрес = Строка(ДанныеСобытия.Href);
	КонецЕсли;

	Возврат СокрЛП(Адрес);

КонецФункции

// Приводит ссылку статьи к пути оглавления.
//
// Внутри справки встречаются два вида ссылок:
//  v8help://SyntaxHelperContext/objects/catalog234/ValueTableRow.html - абсолютная,
//  ValueTable/methods/Add110.html - относительно каталога текущей статьи.
//
// Параметры:
//  Ссылка       - Строка - значение атрибута href.
//  ОткудаПереход - Строка - путь статьи, в которой нажали ссылку.
//
// Возвращаемое значение:
//  Строка - путь вида "/objects/catalog234/Add110.html" или пустая строка.
//
&НаКлиенте
Функция ПутьПоСсылке(знач Ссылка, знач ОткудаПереход)

	Адрес = Ссылка;

	Позиция = СтрНайти(Адрес, "#");
	Если Позиция > 0 Тогда
		Адрес = Лев(Адрес, Позиция - 1);
	КонецЕсли;

	Позиция = СтрНайти(Адрес, "?");
	Если Позиция > 0 Тогда
		Адрес = Лев(Адрес, Позиция - 1);
	КонецЕсли;

	Адрес = СтрЗаменить(Адрес, "\", "/");
	Если ПустаяСтрока(Адрес) Тогда
		Возврат "";
	КонецЕсли;

	НижнийАдрес = НРег(Адрес);

	Если СтрНачинаетсяС(НижнийАдрес, "v8help://") Тогда
		// после схемы идёт имя контекста, а за ним уже путь оглавления
		Остаток = Сред(Адрес, СтрДлина("v8help://") + 1);
		Позиция = СтрНайти(Остаток, "/");
		Возврат ?(Позиция = 0, "", НормализоватьПуть(Сред(Остаток, Позиция)));
	КонецЕсли;

	Если СтрНачинаетсяС(НижнийАдрес, "http://")
		Или СтрНачинаетсяС(НижнийАдрес, "https://")
		Или СтрНачинаетсяС(НижнийАдрес, "mailto:") Тогда
		Возврат "";
	КонецЕсли;

	Если СтрНачинаетсяС(Адрес, "/") Тогда
		Возврат НормализоватьПуть(Адрес);
	КонецЕсли;

	Возврат НормализоватьПуть(КаталогПути(ОткудаПереход) + Адрес);

КонецФункции

// Убирает "." и ".." из пути и оставляет один ведущий разделитель.
&НаКлиенте
Функция НормализоватьПуть(знач Путь)

	Сегменты = Новый Массив;

	Для Каждого Сегмент Из СтрРазделить(Путь, "/", Ложь) Цикл
		Если Сегмент = "." Тогда
			Продолжить;
		ИначеЕсли Сегмент = ".." Тогда
			Если Сегменты.Количество() > 0 Тогда
				Сегменты.Удалить(Сегменты.Количество() - 1);
			КонецЕсли;
		Иначе
			Сегменты.Добавить(Сегмент);
		КонецЕсли;
	КонецЦикла;

	Если Сегменты.Количество() = 0 Тогда
		Возврат "";
	КонецЕсли;

	Возврат "/" + СтрСоединить(Сегменты, "/");

КонецФункции

// Каталог пути статьи вместе с завершающим разделителем.
&НаКлиенте
Функция КаталогПути(знач Путь)

	Позиция = СтрДлина(Путь);
	Пока Позиция > 0 И Сред(Путь, Позиция, 1) <> "/" Цикл
		Позиция = Позиция - 1;
	КонецЦикла;

	Возврат Лев(Путь, Позиция);

КонецФункции

#КонецОбласти

// Ниже сборщик подставляет движок: разбор пакета, чтение файлов, иконки, а в
// проверочной сборке ещё и самопроверку. Исходники - engine_client.bsl,
// engine_data.bsl, icons.bsl, form_check.bsl; склейка - formsrc.py.

#Область РазборПакета

////////////////////////////////////////////////////////////////////////////////
// Движок справки, клиентская часть: разбор оглавления, дерево, поиск, виды узлов.
//
// Файлов не касается вовсе - только строки и коллекции, поэтому работает в любом
// клиенте, включая строгий режим с запретом синхронных вызовов. Всё файловое
// живёт в engine_server.bsl.
//
// Директивы компиляции не проставлены намеренно: сборщик ставит &НаКлиенте
// в модуле формы и оставляет как есть в стенде движка.
//
// Локальные переменные не должны называться как свойства формы (Заголовок,
// Элементы, Команды, Параметры, Окно): в модуле формы присваивание уйдёт в свойство.
////////////////////////////////////////////////////////////////////////////////


// Собирает рабочий пакет из того, что вернул сервер.
//
// Параметры:
//  Ответ  - Структура - результат ПодготовитьПакет: ПутьХранилища, Оглавление, Индекс.
//  Замеры - Соответствие, Неопределено - если передано, заполняется временем шагов в мс.
//
// Возвращаемое значение:
//  Структура:
//    * ПутьХранилища - Строка - вырезанный zip со статьями на сервере
//    * Узлы          - Соответствие - идентификатор -> узел оглавления
//    * Дети          - Соответствие - идентификатор -> Массив идентификаторов
//    * Корни         - Массив - идентификаторы верхнего уровня
//    * Индекс        - Соответствие - путь статьи -> Структура Смещение, Размер
//    * Кеш           - Соответствие - путь статьи -> HTML
//
&НаКлиенте
Функция СобратьПакет(знач Ответ, знач Замеры = Неопределено)

	Часы = ТекущаяУниверсальнаяДатаВМиллисекундах();
	Разобранное = РазобратьОглавление(Ответ.Оглавление);
	ЗаписатьЗамерКлиента(Замеры, "РазборОглавления", Часы);

	Часы = ТекущаяУниверсальнаяДатаВМиллисекундах();
	Индекс = РазобратьИндекс(Ответ.Индекс);
	ЗаписатьЗамерКлиента(Замеры, "РазборИндекса", Часы);

	Пакет = Новый Структура;
	Пакет.Вставить("ПутьХранилища", Ответ.ПутьХранилища);
	Пакет.Вставить("Узлы", Разобранное.Узлы);
	Пакет.Вставить("Дети", Разобранное.Дети);
	Пакет.Вставить("Корни", Разобранное.Корни);
	Пакет.Вставить("Индекс", Индекс);
	Пакет.Вставить("Кеш", Новый Соответствие);
	Пакет.Вставить("ПутиУзлов", Неопределено);

	Возврат Пакет;

КонецФункции

// Возвращает узлы-дети указанного узла в порядке оглавления.
//
// Параметры:
//  Пакет         - Структура - результат СобратьПакет.
//  Идентификатор - Число, Неопределено - Неопределено означает верхний уровень.
//
// Возвращаемое значение:
//  Массив из Структура - узлы оглавления.
//
&НаКлиенте
Функция ДетиУзла(знач Пакет, знач Идентификатор = Неопределено)

	Результат = Новый Массив;

	Если Идентификатор = Неопределено Тогда
		Список = Пакет.Корни;
	Иначе
		Список = Пакет.Дети.Получить(Идентификатор);
	КонецЕсли;

	Если Список = Неопределено Тогда
		Возврат Результат;
	КонецЕсли;

	Для Каждого Ссылка Из Список Цикл
		Узел = Пакет.Узлы.Получить(Ссылка);
		Если Узел <> Неопределено Тогда
			Результат.Добавить(Узел);
		КонецЕсли;
	КонецЦикла;

	Возврат Результат;

КонецФункции

// Ищет статьи по началу русского или английского имени.
//
// Параметры:
//  Пакет    - Структура - результат СобратьПакет.
//  Префикс  - Строка - что набрал пользователь.
//  Максимум - Число - ограничение размера выдачи.
//
// Возвращаемое значение:
//  Массив из Структура - узлы оглавления, точные совпадения первыми.
//
&НаКлиенте
Функция НайтиПоПрефиксу(знач Пакет, знач Префикс, знач Максимум = 300)

	Результат = Новый Массив;
	Образец = НРег(СокрЛП(Префикс));
	Если ПустаяСтрока(Образец) Тогда
		Возврат Результат;
	КонецЕсли;

	Точные = Новый Массив;
	Начинающиеся = Новый Массив;

	Для Каждого КлючИЗначение Из Пакет.Узлы Цикл

		Узел = КлючИЗначение.Значение;
		Если Узел.Служебный Или ПустаяСтрока(Узел.Путь) Тогда
			Продолжить;
		КонецЕсли;

		ИмяРу = НРег(Узел.ИмяРу);
		ИмяEn = НРег(Узел.ИмяEn);

		Если ИмяРу = Образец Или ИмяEn = Образец Тогда
			Точные.Добавить(Узел);
		ИначеЕсли СтрНачинаетсяС(ИмяРу, Образец) Или СтрНачинаетсяС(ИмяEn, Образец) Тогда
			Если Начинающиеся.Количество() < Максимум Тогда
				Начинающиеся.Добавить(Узел);
			КонецЕсли;
		КонецЕсли;

	КонецЦикла;

	Для Каждого Узел Из Точные Цикл
		Результат.Добавить(Узел);
	КонецЦикла;
	Для Каждого Узел Из Начинающиеся Цикл
		Если Результат.Количество() >= Максимум Тогда
			Прервать;
		КонецЕсли;
		Результат.Добавить(Узел);
	КонецЦикла;

	Возврат Результат;

КонецФункции

// Сортирует найденное по алфавиту - индекс синтакс-помощника выглядит именно так.
//
// Параметры:
//  Совпадения - Массив из Структура - узел и его представление.
//
// Возвращаемое значение:
//  Массив из Структура - те же элементы по возрастанию представления.
//
&НаКлиенте
Функция ПоАлфавиту(знач Совпадения)

	Список = Новый СписокЗначений;
	Для Каждого Совпадение Из Совпадения Цикл
		Список.Добавить(Совпадение, Совпадение.Представление);
	КонецЦикла;
	Список.СортироватьПоПредставлению();

	Результат = Новый Массив;
	Для Каждого Элемент Из Список Цикл
		Результат.Добавить(Элемент.Значение);
	КонецЦикла;

	Возврат Результат;

КонецФункции

// Определяет вид узла для подбора иконки дерева.
//
// Служебные разделы оглавления называются по-русски ("Свойства", "Методы", "События"),
// а их дети собственного признака вида не несут - вид листа берётся от раздела-владельца.
//
// Параметры:
//  Пакет - Структура - результат СобратьПакет.
//  Узел  - Структура - узел оглавления.
//
// Возвращаемое значение:
//  Строка - Раздел, Объект, Метод, Свойство, Событие или Статья.
//
&НаКлиенте
Функция ВидУзла(знач Пакет, знач Узел)

	Если Узел.Служебный Тогда
		Возврат ВидРаздела(Узел.ИмяРу);
	КонецЕсли;

	Если Узел.ЧислоДетей > 0 Тогда
		Возврат "Объект";
	КонецЕсли;

	УзелВладелец = Пакет.Узлы.Получить(Узел.Родитель);
	Если УзелВладелец <> Неопределено И УзелВладелец.Служебный Тогда
		Вид = ВидРаздела(УзелВладелец.ИмяРу);
		Если Вид <> "Раздел" Тогда
			Возврат Вид;
		КонецЕсли;
	КонецЕсли;

	Возврат "Статья";

КонецФункции

// Узел оглавления по пути статьи - чтобы показать в дереве то, что открыто в статье.
//
// Карта путей строится лениво: открытие пакета остаётся быстрым, платит первый поиск.
//
// Параметры:
//  Пакет - Структура - результат СобратьПакет.
//  Путь  - Строка - путь статьи.
//
// Возвращаемое значение:
//  Структура, Неопределено - узел оглавления.
//
&НаКлиенте
Функция УзелПоПути(знач Пакет, знач Путь)

	Если ПустаяСтрока(Путь) Тогда
		Возврат Неопределено;
	КонецЕсли;

	Если Пакет.ПутиУзлов = Неопределено Тогда
		Карта = Новый Соответствие;
		Для Каждого КлючИЗначение Из Пакет.Узлы Цикл
			Узел = КлючИЗначение.Значение;
			Если Не ПустаяСтрока(Узел.Путь) И Карта.Получить(КлючПути(Узел.Путь)) = Неопределено Тогда
				Карта.Вставить(КлючПути(Узел.Путь), Узел);
			КонецЕсли;
		КонецЦикла;
		Пакет.ПутиУзлов = Карта;
	КонецЕсли;

	Возврат Пакет.ПутиУзлов.Получить(КлючПути(Путь));

КонецФункции

// Путь от корня до узла включительно - по нему дерево раскрывается до нужной ветки.
//
// Параметры:
//  Пакет - Структура - результат СобратьПакет.
//  Узел  - Структура - узел оглавления.
//
// Возвращаемое значение:
//  Массив из Структура - узлы от корня к указанному.
//
&НаКлиенте
Функция ЦепочкаДоУзла(знач Пакет, знач Узел)

	Обратная = Новый Массив;
	Текущий = Узел;

	Пока Текущий <> Неопределено Цикл
		Обратная.Добавить(Текущий);
		Если Текущий.Родитель = Текущий.Идентификатор Тогда
			Прервать;
		КонецЕсли;
		Текущий = Пакет.Узлы.Получить(Текущий.Родитель);
	КонецЦикла;

	Результат = Новый Массив;
	Для Сч = 1 По Обратная.Количество() Цикл
		Результат.Добавить(Обратная[Обратная.Количество() - Сч]);
	КонецЦикла;

	Возврат Результат;

КонецФункции

// Ближайший вверх узел со статьёй: служебные разделы ("Свойства", "Методы") проскакиваем.
//
// Параметры:
//  Пакет - Структура - результат СобратьПакет.
//  Узел  - Структура - узел оглавления.
//
// Возвращаемое значение:
//  Структура, Неопределено - узел со статьёй.
//
&НаКлиенте
Функция ВышестоящийУзел(знач Пакет, знач Узел)

	Текущий = Пакет.Узлы.Получить(Узел.Родитель);

	Пока Текущий <> Неопределено Цикл
		Если Не ПустаяСтрока(Текущий.Путь) Тогда
			Возврат Текущий;
		КонецЕсли;
		Если Текущий.Родитель = Текущий.Идентификатор Тогда
			Прервать;
		КонецЕсли;
		Текущий = Пакет.Узлы.Получить(Текущий.Родитель);
	КонецЦикла;

	Возврат Неопределено;

КонецФункции

// Первый вниз узел со статьёй в порядке оглавления.
//
// Параметры:
//  Пакет - Структура - результат СобратьПакет.
//  Узел  - Структура - узел оглавления.
//
// Возвращаемое значение:
//  Структура, Неопределено - узел со статьёй.
//
&НаКлиенте
Функция НижестоящийУзел(знач Пакет, знач Узел)

	Для Каждого Ребёнок Из ДетиУзла(Пакет, Узел.Идентификатор) Цикл

		Если Не ПустаяСтрока(Ребёнок.Путь) Тогда
			Возврат Ребёнок;
		КонецЕсли;

		// Служебный раздел статьи не несёт - заглядываем внутрь него.
		Глубже = НижестоящийУзел(Пакет, Ребёнок);
		Если Глубже <> Неопределено Тогда
			Возврат Глубже;
		КонецЕсли;

	КонецЦикла;

	Возврат Неопределено;

КонецФункции

// Полное имя статьи для списка поиска: владельцы через точку, как в конфигураторе -
// "ТаблицаЗначений.Добавить (ValueTable.Add)".
//
// В имя попадают только объекты. Разделы оглавления ("Универсальные коллекции значений")
// и служебные группы ("Свойства", "Методы") - часть навигации, а не имени, и опознаются
// по имени файла статьи: у разделов это catalog<номер>.
//
// Параметры:
//  Пакет - Структура - результат СобратьПакет.
//  Узел  - Структура - узел оглавления.
//
// Возвращаемое значение:
//  Строка - имя с владельцами и английским вариантом в скобках.
//
&НаКлиенте
Функция ПолноеИмяУзла(знач Пакет, знач Узел)

	Русские = Новый Массив;
	Английские = Новый Массив;
	ЕстьАнглийские = Истина;

	Для Каждого Звено Из ЦепочкаДоУзла(Пакет, Узел) Цикл

		Если Звено <> Узел И ЭтоРазделОглавления(Звено) Тогда
			Продолжить;
		КонецЕсли;

		Русские.Добавить(Звено.ИмяРу);
		Если ПустаяСтрока(Звено.ИмяEn) Тогда
			ЕстьАнглийские = Ложь;
		Иначе
			Английские.Добавить(Звено.ИмяEn);
		КонецЕсли;

	КонецЦикла;

	Имя = СтрСоединить(Русские, ".");
	Если ЕстьАнглийские И Английские.Количество() > 0 Тогда
		Имя = Имя + " (" + СтрСоединить(Английские, ".") + ")";
	КонецЕсли;

	Возврат Имя;

КонецФункции

// Место статьи в хранилище: с ним сервер читает ровно одну запись архива.
//
// Параметры:
//  Пакет - Структура - результат СобратьПакет.
//  Путь  - Строка - путь вида "/objects/catalog234/ValueTable.html".
//
// Возвращаемое значение:
//  Структура, Неопределено - Смещение и Размер записи либо Неопределено, если статьи нет.
//
&НаКлиенте
Функция МестоСтатьи(знач Пакет, знач Путь)

	Возврат Пакет.Индекс.Получить(КлючПути(Путь));

КонецФункции



#Область РазборОглавления

// Разбирает текст оглавления в узлы, связи и корни.
//
// Узел записан так:
//   {ид,родитель,числоДетей,ид1,ид2,...,
//   {1,1,
//   {1,2,
//   {"ru","ТаблицаЗначений"},
//   {"en","ValueTable"}
//   },"/objects/catalog234/catalog236/ValueTable.html"}
//   },
//
// Служебные разделы вместо пары имён несут {"#","Свойства"} и пустой путь.
&НаКлиенте
Функция РазобратьОглавление(знач Текст)

	Узлы = Новый Соответствие;
	Дети = Новый Соответствие;
	Корни = Новый Массив;
	Порядок = Новый Массив;

	Текущий = Неопределено;

	Для Каждого Строка Из СтрРазделить(Текст, Символы.ПС, Ложь) Цикл

		Если ПустаяСтрока(Строка) Тогда
			Продолжить;
		КонецЕсли;

		Первый = Лев(Строка, 1);
		Второй = Сред(Строка, 2, 1);

		Если Первый = "{" И Второй >= "0" И Второй <= "9" Тогда

			// Внутренние блоки узла ({1,1, и {1,2,) выглядят похоже, но несут меньше трёх чисел -
			// такие строки не начинают новый узел и текущий не сбрасывают.
			Разобранный = НовыйУзел(Строка, Узлы, Дети, Порядок);
			Если Разобранный <> Неопределено Тогда
				Текущий = Разобранный;
			КонецЕсли;

		ИначеЕсли Текущий <> Неопределено И Первый = "{" И Второй = """" Тогда

			ЗаполнитьИмяУзла(Текущий, Строка);

		ИначеЕсли Текущий <> Неопределено И Первый = "}" И СтрНайти(Строка, """") > 0 Тогда

			Текущий.Путь = МеждуКавычками(Строка);
			Текущий = Неопределено;

		КонецЕсли;

	КонецЦикла;

	// Корень - узел, чей родитель в оглавлении отсутствует либо совпадает с ним самим.
	// Порядок обхода сохраняем документным, чтобы дерево выглядело как в справке.
	Для Каждого Идентификатор Из Порядок Цикл
		Узел = Узлы.Получить(Идентификатор);
		Если Узел.Родитель = Идентификатор Или Узлы.Получить(Узел.Родитель) = Неопределено Тогда
			Корни.Добавить(Идентификатор);
		КонецЕсли;
	КонецЦикла;

	Возврат Новый Структура("Узлы, Дети, Корни", Узлы, Дети, Корни);

КонецФункции

// Разбирает индекс архива: строки вида "путь<таб>смещение<таб>размер".
&НаКлиенте
Функция РазобратьИндекс(знач Текст)

	Индекс = Новый Соответствие;

	Для Каждого Строка Из СтрРазделить(Текст, Символы.ПС, Ложь) Цикл

		Части = СтрРазделить(Строка, Символы.Таб, Истина);
		Если Части.Количество() < 3 Тогда
			Продолжить;
		КонецЕсли;

		Место = Новый Структура("Смещение, Размер", Число(Части[1]), Число(Части[2]));
		Индекс.Вставить(КлючПути(Части[0]), Место);

	КонецЦикла;

	Возврат Индекс;

КонецФункции

// Раздел оглавления - служебная группа либо узел, чья статья названа catalog<номер>:
// такие узлы группируют, но именем объекта не являются.
&НаКлиенте
Функция ЭтоРазделОглавления(знач Узел)

	Если Узел.Служебный Или ПустаяСтрока(Узел.Путь) Тогда
		Возврат Истина;
	КонецЕсли;

	Сегменты = СтрРазделить(СтрЗаменить(Узел.Путь, "\", "/"), "/", Ложь);
	Если Сегменты.Количество() = 0 Тогда
		Возврат Истина;
	КонецЕсли;

	Возврат СтрНачинаетсяС(НРег(Сегменты[Сегменты.Количество() - 1]), "catalog");

КонецФункции

// Приводит путь оглавления и имя в архиве к общему виду: нижний регистр,
// прямые разделители, ведущий разделитель.
&НаКлиенте
Функция КлючПути(знач Путь)

	Ключ = НРег(СтрЗаменить(Путь, "\", "/"));

	Пока СтрНачинаетсяС(Ключ, "/") Цикл
		Ключ = Сред(Ключ, 2);
	КонецЦикла;

	Возврат "/" + Ключ;

КонецФункции

// Разбирает строку-заголовок узла и регистрирует его в индексах.
&НаКлиенте
Функция НовыйУзел(знач Строка, знач Узлы, знач Дети, знач Порядок)

	Части = СтрРазделить(СокрЛП(СтрЗаменить(СтрЗаменить(Строка, "{", ""), ",", " ")), " ", Ложь);
	Если Части.Количество() < 3 Тогда
		Возврат Неопределено;
	КонецЕсли;

	Узел = Новый Структура;
	Узел.Вставить("Идентификатор", Число(Части[0]));
	Узел.Вставить("Родитель", Число(Части[1]));
	Узел.Вставить("ЧислоДетей", Число(Части[2]));
	Узел.Вставить("ИмяРу", "");
	Узел.Вставить("ИмяEn", "");
	Узел.Вставить("Путь", "");
	Узел.Вставить("Служебный", Ложь);

	Узлы.Вставить(Узел.Идентификатор, Узел);
	Порядок.Добавить(Узел.Идентификатор);

	Если Узел.ЧислоДетей > 0 Тогда
		Ссылки = Новый Массив;
		Для Сч = 3 По Части.Количество() - 1 Цикл
			Ссылки.Добавить(Число(Части[Сч]));
		КонецЦикла;
		Дети.Вставить(Узел.Идентификатор, Ссылки);
	КонецЕсли;

	Возврат Узел;

КонецФункции

// Раскладывает строку вида {"ru","ТаблицаЗначений"} по полям узла.
&НаКлиенте
Процедура ЗаполнитьИмяУзла(знач Узел, знач Строка)

	Разделитель = СтрНайти(Строка, """,""");
	Если Разделитель = 0 Тогда
		Возврат;
	КонецЕсли;

	Язык = Сред(Строка, 3, Разделитель - 3);
	Остаток = Сред(Строка, Разделитель + 3);
	Конец = СтрНайти(Остаток, """");
	Если Конец = 0 Тогда
		Возврат;
	КонецЕсли;
	Значение = Лев(Остаток, Конец - 1);

	Если Язык = "ru" Тогда
		Узел.ИмяРу = Значение;
	ИначеЕсли Язык = "en" Тогда
		Узел.ИмяEn = Значение;
	ИначеЕсли Язык = "#" Тогда
		Узел.ИмяРу = Значение;
		Узел.Служебный = Истина;
	КонецЕсли;

КонецПроцедуры

// Сопоставляет имя служебного раздела оглавления виду узла.
&НаКлиенте
Функция ВидРаздела(знач Имя)

	Образец = НРег(Имя);

	Если СтрНачинаетсяС(Образец, "метод")
		Или СтрНачинаетсяС(Образец, "конструктор")
		Или СтрНачинаетсяС(Образец, "процедуры и функции") Тогда
		Возврат "Метод";
	КонецЕсли;

	Если СтрНачинаетсяС(Образец, "свойств")
		Или СтрНачинаетсяС(Образец, "реквизит")
		Или СтрНачинаетсяС(Образец, "поля")
		Или СтрНачинаетсяС(Образец, "параметр") Тогда
		Возврат "Свойство";
	КонецЕсли;

	Если СтрНачинаетсяС(Образец, "событ") Тогда
		Возврат "Событие";
	КонецЕсли;

	Возврат "Раздел";

КонецФункции

// Возвращает содержимое первых кавычек в строке.
&НаКлиенте
Функция МеждуКавычками(знач Строка)

	Начало = СтрНайти(Строка, """");
	Если Начало = 0 Тогда
		Возврат "";
	КонецЕсли;

	Остаток = Сред(Строка, Начало + 1);
	Конец = СтрНайти(Остаток, """");
	Если Конец = 0 Тогда
		Возврат "";
	КонецЕсли;

	Возврат Лев(Остаток, Конец - 1);

КонецФункции

// Записывает длительность шага, если сбор замеров включён.
&НаКлиенте
Процедура ЗаписатьЗамерКлиента(знач Замеры, знач Шаг, знач Начало)

	Если Замеры <> Неопределено Тогда
		Замеры.Вставить(Шаг, ТекущаяУниверсальнаяДатаВМиллисекундах() - Начало);
	КонецЕсли;

КонецПроцедуры

#КонецОбласти

#КонецОбласти

#Область ЧтениеФайлов

////////////////////////////////////////////////////////////////////////////////
// Движок справки, работа с данными пакета: всё, что трогает файлы.
//
// Код клиент-серверный: тонкий и толстый клиенты и сервер умеют всё, что здесь нужно.
// Где именно читать - решает вызывающий по доступности файла: пакет лежит рядом с
// клиентом, но серверу он может быть недоступен (другая машина, Linux, сетевой каталог),
// и наоборот.
//
// Веб-клиент файлов не видит вовсе, поэтому там каждый метод отказывает с именем метода
// в тексте: путь один - работать на сервере, а если и там пакета нет, вызывающий
// сообщает об этом пользователю. Молчаливая заглушка прятала бы причину.
//
// Вызовы без состояния: всё, что нужно для чтения статьи, приносит с собой вызывающий.
//
// Директивы компиляции не проставлены намеренно: сборщик ставит
// &НаКлиентеНаСервереБезКонтекста в модуле формы и оставляет как есть в стенде.
////////////////////////////////////////////////////////////////////////////////


// Единая точка отказа для веб-клиента. Молчаливая заглушка прячет причину, поэтому
// метод честно говорит, что именно не выполнилось: вызывающий ловит исключение и
// уходит на сервер, а в журнале и в отладке видно, где это случилось.
//
// Параметры:
//  ИмяМетода - Строка - метод, который вызвали не в том месте.
//
&НаКлиентеНаСервереБезКонтекста
Процедура ВебКлиентНеПоддерживается(знач ИмяМетода)

	ВызватьИсключение СтрШаблон(
		НСтр("ru = 'Метод %1 в веб-клиенте не поддерживается: файлы читаются на сервере'"),
		ИмяМетода);

КонецПроцедуры

// Истина, если файл читается отсюда - с той стороны, где выполняется этот код.
//
// Параметры:
//  Путь - Строка - полное имя файла.
//
// Возвращаемое значение:
//  Булево - в веб-клиенте вызывает исключение.
//
&НаКлиентеНаСервереБезКонтекста
Функция ФайлДоступен(знач Путь)

#Если ВебКлиент Или МобильныйКлиент Тогда
	ВебКлиентНеПоддерживается("ФайлДоступен");
#Иначе
	Если ПустаяСтрока(Путь) Тогда
		Возврат Ложь;
	КонецЕсли;

	Файл = Новый Файл(Путь);

	Возврат Файл.Существует() И Файл.ЭтоФайл();
#КонецЕсли

КонецФункции

// Ищет файл справки платформы: сначала в каталоге текущей версии, затем в
// соседних каталогах версий (самая свежая первой).
//
// Параметры:
//  Префикс - Строка - "shcntx" (объектная модель) или "shlang" (встроенный язык).
//
// Возвращаемое значение:
//  Строка - полный путь или пустая строка, если файл не найден.
//
&НаКлиентеНаСервереБезКонтекста
Функция НайтиФайлСправки(знач Префикс = "shcntx")

#Если ВебКлиент Или МобильныйКлиент Тогда
	ВебКлиентНеПоддерживается("НайтиФайлСправки");
#Иначе
	Маска = Префикс + "_*.hbk";

	Найденные = НайтиФайлы(КаталогПрограммы(), Маска);
	Если Найденные.Количество() > 0 Тогда
		Возврат ЛучшийФайлСправки(Найденные);
	КонецЕсли;

	// bin -> каталог версии -> корень установки платформы
	КорневойКаталог = РодительскийКаталог(РодительскийКаталог(КаталогПрограммы()));
	Если ПустаяСтрока(КорневойКаталог) Тогда
		Возврат "";
	КонецЕсли;

	Версии = Новый Массив;
	Для Каждого Элемент Из НайтиФайлы(КорневойКаталог, "*") Цикл
		Если Элемент.ЭтоКаталог() И ЭтоНомерВерсии(Элемент.Имя) Тогда
			Версии.Добавить(Элемент);
		КонецЕсли;
	КонецЦикла;

	Отсортированные = ПоУбываниюВерсий(Версии);
	Для Каждого Версия Из Отсортированные Цикл
		Найденные = НайтиФайлы(Версия.ПолноеИмя + ПолучитьРазделительПути() + "bin", Маска);
		Если Найденные.Количество() > 0 Тогда
			Возврат ЛучшийФайлСправки(Найденные);
		КонецЕсли;
	КонецЦикла;

	Возврат "";
#КонецЕсли

КонецФункции

// Готовит пакет справки к работе: вырезает хранилище статей, читает оглавление
// и строит индекс статей. Тяжёлые данные остаются на диске.
//
// Параметры:
//  ПутьHBK - Строка - полный путь к файлу справки.
//  Замеры  - Соответствие, Неопределено - если передано, заполняется временем шагов в мс.
//
// Возвращаемое значение:
//  Структура:
//    * ПутьХранилища - Строка - вырезанный zip со статьями, лежит рядом во временных
//    * Оглавление    - Строка - текст оглавления, разбирает его вызывающий
//    * Индекс        - Строка - строки вида "путь<таб>смещение<таб>размер"
//  В веб-клиенте вызывает исключение.
//
&НаКлиентеНаСервереБезКонтекста
Функция ПодготовитьПакет(знач ПутьHBK, знач Замеры = Неопределено)

#Если ВебКлиент Или МобильныйКлиент Тогда
	ВебКлиентНеПоддерживается("ПодготовитьПакет");
#Иначе
	Поток = ФайловыеПотоки.ОткрытьДляЧтения(ПутьHBK);

	Попытка

		Часы = ТекущаяУниверсальнаяДатаВМиллисекундах();
		Сущности = ПрочитатьТаблицуСущностей(Поток);
		ЗаписатьЗамер(Замеры, "ТаблицаСущностей", Часы);

		Хранилище = Сущности.Получить("FileStorage");
		Если Хранилище = Неопределено Тогда
			ВызватьИсключение НСтр("ru = 'В файле нет хранилища статей: это не пакет справки 1С'");
		КонецЕсли;

		Часы = ТекущаяУниверсальнаяДатаВМиллисекундах();
		ПутьХранилища = ПутьВременногоФайла(ПутьHBK, Хранилище.Длина, "hbk_files");
		Если Не ФайлГотов(ПутьХранилища, Хранилище.Длина) Тогда
			СкопироватьФрагментВФайл(Поток, Хранилище.Смещение, Хранилище.Длина, ПутьХранилища);
		КонецЕсли;
		ЗаписатьЗамер(Замеры, "ВырезаниеХранилища", Часы);

		Часы = ТекущаяУниверсальнаяДатаВМиллисекундах();
		Оглавление = Сущности.Получить("PackBlock");
		Если Оглавление = Неопределено Тогда
			ВызватьИсключение НСтр("ru = 'В файле нет оглавления'");
		КонецЕсли;
		ТекстОглавления = РаспаковатьЗапись(ПрочитатьФрагмент(Поток, Оглавление.Смещение, Оглавление.Длина));
		ЗаписатьЗамер(Замеры, "ЧтениеОглавления", Часы);

	Исключение
		Поток.Закрыть();
		ВызватьИсключение;
	КонецПопытки;

	Поток.Закрыть();

	Часы = ТекущаяУниверсальнаяДатаВМиллисекундах();
	Индекс = ПрочитатьИндексАрхива(ПутьХранилища);
	ЗаписатьЗамер(Замеры, "ИндексАрхива", Часы);

	Результат = Новый Структура;
	Результат.Вставить("ПутьХранилища", ПутьХранилища);
	Результат.Вставить("Оглавление", ТекстОглавления);
	Результат.Вставить("Индекс", Индекс);

	Возврат Результат;
#КонецЕсли

КонецФункции

// Достаёт одну статью из хранилища по известному смещению записи.
//
// Штатным ЧтениеZipФайла здесь пользоваться нельзя: на 52 тысячах элементов его
// поиск идёт перебором и стоит полсекунды на статью. Вместо этого читается ровно
// одна запись архива, вокруг неё достраивается корректный zip - тот же приём, что
// и с оглавлением.
//
// Параметры:
//  ПутьХранилища - Строка - вырезанный zip со статьями.
//  Смещение      - Число - позиция локальной записи в файле.
//  Размер        - Число - размер сжатых данных.
//
// Возвращаемое значение:
//  Строка - HTML статьи или пустая строка.
//
&НаКлиентеНаСервереБезКонтекста
Функция ПрочитатьСтатью(знач ПутьХранилища, знач Смещение, знач Размер)

#Если ВебКлиент Или МобильныйКлиент Тогда
	ВебКлиентНеПоддерживается("ПрочитатьСтатью");
#Иначе
	Поток = ФайловыеПотоки.ОткрытьДляЧтения(ПутьХранилища);

	Попытка
		// Локальный заголовок: 30 байт плюс имя и дополнение, длины в нём же.
		Шапка = ПрочитатьФрагмент(Поток, Смещение, 30);
		ДлинаИмени = Шапка.ПрочитатьЦелое16(26);
		ДлинаДополнения = Шапка.ПрочитатьЦелое16(28);
		Запись = ПрочитатьФрагмент(Поток, Смещение, 30 + ДлинаИмени + ДлинаДополнения + Размер);
	Исключение
		Поток.Закрыть();
		ВызватьИсключение;
	КонецПопытки;

	Поток.Закрыть();

	Возврат РаспаковатьЗапись(Запись);
#КонецЕсли

КонецФункции


// Служебное целиком выключено там, где файлов нет: иначе модуль не соберётся под
// веб-клиент - ФайловыеПотоки и ЧтениеZipФайла в нём просто не существуют.
#Если Не (ВебКлиент Или МобильныйКлиент) Тогда


#Область РазборКонтейнера

// Читает таблицу сущностей контейнера: имя -> смещение и длина тела.
&НаКлиентеНаСервереБезКонтекста
Функция ПрочитатьТаблицуСущностей(знач Поток)

	ЗаголовокКонтейнера = ПрочитатьФрагмент(Поток, 0, 64);
	Если ЗаголовокКонтейнера.Размер < 64 Тогда
		ВызватьИсключение НСтр("ru = 'Файл слишком короткий для контейнера справки'");
	КонецЕсли;

	РазмерТаблицы = ЧислоИзHex(ЗаголовокКонтейнера, 18);
	Если РазмерТаблицы = 0 Или РазмерТаблицы % 12 <> 0 Тогда
		ВызватьИсключение НСтр("ru = 'Повреждена таблица файлов контейнера'");
	КонецЕсли;

	// 18 + 9 (длина таблицы) + 9 (длина блока) + 11 служебных байт
	Таблица = ПрочитатьФрагмент(Поток, 47, РазмерТаблицы);
	Сущности = Новый Соответствие;

	Позиция = 0;
	Пока Позиция < РазмерТаблицы Цикл

		АдресЗаголовка = Таблица.ПрочитатьЦелое32(Позиция);
		АдресТела = Таблица.ПрочитатьЦелое32(Позиция + 4);
		Признак = Таблица.ПрочитатьЦелое32(Позиция + 8);
		Если Признак <> 2147483647 Тогда
			ВызватьИсключение НСтр("ru = 'Повреждена запись таблицы файлов контейнера'");
		КонецЕсли;

		ЗаголовокЗаписи = ПрочитатьФрагмент(Поток, АдресЗаголовка, 11);
		ДлинаИмени = ЧислоИзHex(ЗаголовокЗаписи, 2);

		ИмяБуфер = ПрочитатьФрагмент(Поток, АдресЗаголовка + 51, ДлинаИмени - 24);
		Имя = ПолучитьСтрокуИзДвоичныхДанных(
			ПолучитьДвоичныеДанныеИзБуфераДвоичныхДанных(ИмяБуфер), "UTF-16LE");

		ЗаголовокТела = ПрочитатьФрагмент(Поток, АдресТела, 11);
		ДлинаТела = ЧислоИзHex(ЗаголовокТела, 2);

		Сущности.Вставить(Имя, Новый Структура("Смещение, Длина", АдресТела + 31, ДлинаТела));

		Позиция = Позиция + 12;

	КонецЦикла;

	Возврат Сущности;

КонецФункции

// Распаковывает одну локальную запись zip: достраивает вокруг неё корректный
// архив и отдаёт его штатным средствам платформы.
&НаКлиентеНаСервереБезКонтекста
Функция РаспаковатьЗапись(знач Запись)

	Если Запись.ПрочитатьЦелое32(0) <> 67324752 Тогда
		ВызватьИсключение НСтр("ru = 'Запись архива имеет неожиданный формат'");
	КонецЕсли;

	ДлинаИмени = Запись.ПрочитатьЦелое16(26);
	ДлинаДополнения = Запись.ПрочитатьЦелое16(28);
	СжатыйРазмер = Запись.ПрочитатьЦелое32(18);
	ИсходныйРазмер = Запись.ПрочитатьЦелое32(22);
	РазмерЛокальной = 30 + ДлинаИмени + ДлинаДополнения + СжатыйРазмер;

	Каталог = Новый БуферДвоичныхДанных(46 + ДлинаИмени);
	Каталог.ЗаписатьЦелое32(0, 33639248); // сигнатура записи центрального каталога
	Каталог.ЗаписатьЦелое16(4, 20);
	Каталог.ЗаписатьЦелое16(6, Запись.ПрочитатьЦелое16(4));
	Каталог.ЗаписатьЦелое16(8, Запись.ПрочитатьЦелое16(6));
	Каталог.ЗаписатьЦелое16(10, Запись.ПрочитатьЦелое16(8));
	Каталог.ЗаписатьЦелое16(12, Запись.ПрочитатьЦелое16(10));
	Каталог.ЗаписатьЦелое16(14, Запись.ПрочитатьЦелое16(12));
	Каталог.ЗаписатьЦелое32(16, Запись.ПрочитатьЦелое32(14)); // crc32
	Каталог.ЗаписатьЦелое32(20, СжатыйРазмер);
	Каталог.ЗаписатьЦелое32(24, ИсходныйРазмер);
	Каталог.ЗаписатьЦелое16(28, ДлинаИмени);
	Каталог.Записать(46, Запись.ПолучитьСрез(30, ДлинаИмени));

	Хвост = Новый БуферДвоичныхДанных(22);
	Хвост.ЗаписатьЦелое32(0, 101010256); // сигнатура конца центрального каталога
	Хвост.ЗаписатьЦелое16(8, 1);
	Хвост.ЗаписатьЦелое16(10, 1);
	Хвост.ЗаписатьЦелое32(12, Каталог.Размер);
	Хвост.ЗаписатьЦелое32(16, РазмерЛокальной);

	ПутьZip = КаталогВременныхФайлов() + "hbk_запись.zip";
	ПолучитьДвоичныеДанныеИзБуфераДвоичныхДанных(
		Запись.ПолучитьСрез(0, РазмерЛокальной).Соединить(Каталог).Соединить(Хвост)).Записать(ПутьZip);

	Архив = Новый ЧтениеZipФайла(ПутьZip);
	Архив.Извлечь(Архив.Элементы[0], КаталогИзвлечения(), РежимВосстановленияПутейФайловZIP.НеВосстанавливать);
	ИмяФайла = КаталогИзвлечения() + Архив.Элементы[0].Имя;
	Архив.Закрыть();

	Чтение = Новый ЧтениеТекста(ИмяФайла, КодировкаТекста.UTF8);
	Текст = Чтение.Прочитать();
	Чтение.Закрыть();

	Возврат ?(Текст = Неопределено, "", Текст);

КонецФункции

// Читает центральный каталог архива и отдаёт индекс строкой:
// на каждую статью - путь, смещение локальной записи и размер сжатых данных.
//
// Имена в архиве справки - латиница и цифры, поэтому каталог разбирается как
// однобайтовый текст: одно преобразование на весь буфер вместо 52 тысяч.
&НаКлиентеНаСервереБезКонтекста
Функция ПрочитатьИндексАрхива(знач ПутьZip)

	Поток = ФайловыеПотоки.ОткрытьДляЧтения(ПутьZip);

	Попытка

		РазмерФайла = Поток.Размер();
		ХвостДлина = ?(РазмерФайла > 66000, 66000, РазмерФайла);
		Хвост = ПрочитатьФрагмент(Поток, РазмерФайла - ХвостДлина, ХвостДлина);

		Позиция = НайтиКонецКаталога(Хвост);
		Если Позиция < 0 Тогда
			ВызватьИсключение НСтр("ru = 'В хранилище статей не найден каталог архива'");
		КонецЕсли;

		РазмерКаталога = Хвост.ПрочитатьЦелое32(Позиция + 12);
		НачалоКаталога = Хвост.ПрочитатьЦелое32(Позиция + 16);
		Каталог = ПрочитатьФрагмент(Поток, НачалоКаталога, РазмерКаталога);

	Исключение
		Поток.Закрыть();
		ВызватьИсключение;
	КонецПопытки;

	Поток.Закрыть();

	// ISO-8859-1 отображает все 256 байт один в один, поэтому позиция байта в буфере
	// совпадает с позицией символа в строке. Кодировки вроде windows-1251 так не умеют.
	Текст = ПолучитьСтрокуИзДвоичныхДанных(
		ПолучитьДвоичныеДанныеИзБуфераДвоичныхДанных(Каталог), "ISO-8859-1");

	Строки = Новый Массив;
	Сдвиг = 0;

	Пока Сдвиг + 46 <= РазмерКаталога Цикл

		Если Каталог.ПрочитатьЦелое32(Сдвиг) <> 33639248 Тогда
			Прервать;
		КонецЕсли;

		СжатыйРазмер = Каталог.ПрочитатьЦелое32(Сдвиг + 20);
		ДлинаИмени = Каталог.ПрочитатьЦелое16(Сдвиг + 28);
		ДлинаДополнения = Каталог.ПрочитатьЦелое16(Сдвиг + 30);
		ДлинаКомментария = Каталог.ПрочитатьЦелое16(Сдвиг + 32);
		СмещениеЗаписи = Каталог.ПрочитатьЦелое32(Сдвиг + 42);

		// В однобайтовой кодировке позиция байта совпадает с позицией символа,
		// поэтому имя вырезается из текста без обращения к буферу.
		Имя = Сред(Текст, Сдвиг + 47, ДлинаИмени);

		// В хранилище кроме статей лежит служебное - клиенту оно не нужно и вдвое
		// утяжеляет передачу индекса.
		Если СтрЗаканчиваетсяНа(НРег(Имя), ".html") Тогда
			// ЧН=0 обязателен: у нуля по умолчанию пустое представление, а первая
			// запись архива лежит ровно по нулевому смещению.
			Строки.Добавить(Имя + Символы.Таб + Формат(СмещениеЗаписи, "ЧГ=0; ЧН=0")
				+ Символы.Таб + Формат(СжатыйРазмер, "ЧГ=0; ЧН=0"));
		КонецЕсли;

		Сдвиг = Сдвиг + 46 + ДлинаИмени + ДлинаДополнения + ДлинаКомментария;

	КонецЦикла;

	Возврат СтрСоединить(Строки, Символы.ПС);

КонецФункции

// Ищет сигнатуру конца центрального каталога с конца буфера.
&НаКлиентеНаСервереБезКонтекста
Функция НайтиКонецКаталога(знач Хвост)

	Позиция = Хвост.Размер - 22;
	Пока Позиция >= 0 Цикл
		Если Хвост.ПрочитатьЦелое32(Позиция) = 101010256 Тогда
			Возврат Позиция;
		КонецЕсли;
		Позиция = Позиция - 1;
	КонецЦикла;

	Возврат -1;

КонецФункции

// Копирует фрагмент исходного файла в отдельный файл, не поднимая его в память целиком.
&НаКлиентеНаСервереБезКонтекста
Процедура СкопироватьФрагментВФайл(знач Поток, знач Смещение, знач Длина, знач ПутьВыхода)

	РазмерПорции = 1048576;
	Поток.Перейти(Смещение, ПозицияВПотоке.Начало);
	Приёмник = ФайловыеПотоки.Создать(ПутьВыхода);

	Попытка

		Буфер = Новый БуферДвоичныхДанных(РазмерПорции);
		Осталось = Длина;

		Пока Осталось > 0 Цикл
			Порция = ?(Осталось > РазмерПорции, РазмерПорции, Осталось);
			Прочитано = Поток.Прочитать(Буфер, 0, Порция);
			Если Прочитано = 0 Тогда
				Прервать;
			КонецЕсли;
			Приёмник.Записать(Буфер, 0, Прочитано);
			Осталось = Осталось - Прочитано;
		КонецЦикла;

	Исключение
		Приёмник.Закрыть();
		ВызватьИсключение;
	КонецПопытки;

	Приёмник.Закрыть();

КонецПроцедуры

// Читает кусок потока в буфер.
&НаКлиентеНаСервереБезКонтекста
Функция ПрочитатьФрагмент(знач Поток, знач Смещение, знач Длина)

	Поток.Перейти(Смещение, ПозицияВПотоке.Начало);
	Буфер = Новый БуферДвоичныхДанных(Длина);
	Прочитано = Поток.Прочитать(Буфер, 0, Длина);

	Если Прочитано < Длина Тогда
		Возврат Буфер.ПолучитьСрез(0, Прочитано);
	КонецЕсли;

	Возврат Буфер;

КонецФункции

// Восемь ascii-символов шестнадцатеричного числа, как их пишет контейнер 1С.
&НаКлиентеНаСервереБезКонтекста
Функция ЧислоИзHex(знач Буфер, знач Позиция)

	Цифры = "0123456789abcdef";
	Результат = 0;

	Для Сч = 0 По 7 Цикл
		Индекс = СтрНайти(Цифры, НРег(Символ(Буфер.Получить(Позиция + Сч))));
		Если Индекс = 0 Тогда
			ВызватьИсключение НСтр("ru = 'Повреждён заголовок контейнера справки'");
		КонецЕсли;
		Результат = Результат * 16 + Индекс - 1;
	КонецЦикла;

	Возврат Результат;

КонецФункции

#КонецОбласти

#Область ВспомогательныеПроцедурыИФункции

// Имя временного файла, привязанное к исходному пакету и его размеру.
&НаКлиентеНаСервереБезКонтекста
Функция ПутьВременногоФайла(знач ПутьHBK, знач Размер, знач Префикс)

	Файл = Новый Файл(ПутьHBK);
	Ключ = СтрЗаменить(Файл.ИмяБезРасширения, " ", "_");

	Возврат КаталогВременныхФайлов() + Префикс + "_" + Ключ + "_" + Формат(Размер, "ЧГ=0") + ".zip";

КонецФункции

// Истина, если файл уже вырезан и совпадает по размеру.
&НаКлиентеНаСервереБезКонтекста
Функция ФайлГотов(знач Путь, знач Размер)

	Файл = Новый Файл(Путь);
	Возврат Файл.Существует() И Файл.Размер() = Размер;

КонецФункции

// Каталог, куда извлекаются статьи по одной.
&НаКлиентеНаСервереБезКонтекста
Функция КаталогИзвлечения()

	Путь = КаталогВременныхФайлов() + "hbk_articles" + ПолучитьРазделительПути();
	СоздатьКаталог(Путь);

	Возврат Путь;

КонецФункции

// Родительский каталог для пути с завершающим разделителем или без него.
&НаКлиентеНаСервереБезКонтекста
Функция РодительскийКаталог(знач Путь)

	Обрезанный = Путь;
	Пока СтрЗаканчиваетсяНа(Обрезанный, "\") Или СтрЗаканчиваетсяНа(Обрезанный, "/") Цикл
		Обрезанный = Лев(Обрезанный, СтрДлина(Обрезанный) - 1);
	КонецЦикла;

	Файл = Новый Файл(Обрезанный);

	Возврат Файл.Путь;

КонецФункции

// Истина для имён каталогов вида 8.3.27.2214.
&НаКлиентеНаСервереБезКонтекста
Функция ЭтоНомерВерсии(знач Имя)

	Части = СтрРазделить(Имя, ".", Ложь);
	Если Части.Количество() < 2 Тогда
		Возврат Ложь;
	КонецЕсли;

	Для Каждого Часть Из Части Цикл
		Если ПустаяСтрока(Часть) Тогда
			Возврат Ложь;
		КонецЕсли;
		Для Сч = 1 По СтрДлина(Часть) Цикл
			Знак = Сред(Часть, Сч, 1);
			Если Знак < "0" Или Знак > "9" Тогда
				Возврат Ложь;
			КонецЕсли;
		КонецЦикла;
	КонецЦикла;

	Возврат Истина;

КонецФункции

// Каталоги версий от самой свежей к самой старой.
&НаКлиентеНаСервереБезКонтекста
Функция ПоУбываниюВерсий(знач Каталоги)

	Список = Новый СписокЗначений;
	Для Каждого Каталог Из Каталоги Цикл
		Список.Добавить(Каталог, КлючСортировкиВерсии(Каталог.Имя));
	КонецЦикла;
	Список.СортироватьПоПредставлению(НаправлениеСортировки.Убыв);

	Результат = Новый Массив;
	Для Каждого Элемент Из Список Цикл
		Результат.Добавить(Элемент.Значение);
	КонецЦикла;

	Возврат Результат;

КонецФункции

// Ключ сортировки версии: каждый сегмент дополнен нулями до шести знаков.
&НаКлиентеНаСервереБезКонтекста
Функция КлючСортировкиВерсии(знач Имя)

	Ключ = "";
	Для Каждого Часть Из СтрРазделить(Имя, ".", Ложь) Цикл
		Ключ = Ключ + Прав("000000" + Часть, 6);
	КонецЦикла;

	Возврат Ключ;

КонецФункции

// Предпочитаем русский пакет, иначе первый попавшийся.
&НаКлиентеНаСервереБезКонтекста
Функция ЛучшийФайлСправки(знач Файлы)

	Для Каждого Файл Из Файлы Цикл
		Если СтрЗаканчиваетсяНа(НРег(Файл.ИмяБезРасширения), "_ru") Тогда
			Возврат Файл.ПолноеИмя;
		КонецЕсли;
	КонецЦикла;

	Возврат Файлы[0].ПолноеИмя;

КонецФункции

// Записывает длительность шага, если сбор замеров включён.
&НаКлиентеНаСервереБезКонтекста
Процедура ЗаписатьЗамер(знач Замеры, знач Шаг, знач Начало)

	Если Замеры <> Неопределено Тогда
		Замеры.Вставить(Шаг, ТекущаяУниверсальнаяДатаВМиллисекундах() - Начало);
	КонецЕсли;

КонецПроцедуры

